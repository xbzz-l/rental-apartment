# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# ===== 项目标识（同一台机器部署多套时改这个，容器名/卷名/网络名都会跟着变）=====
COMPOSE_PROJECT_NAME=rental
IMAGE_TAG=1.0.0

# ===== 对外端口（宿主机）=====
APP_PORT=8081
ADMIN_PORT=8082
BI_PORT=8083

# ===== MySQL（后端会自动建表并播种初始数据）=====
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=rental_db
# 多台服务器共用同一个数据库时，把 DB_HOST 指向那台库；单机部署保持默认 mysql
DB_HOST=mysql
DB_PORT=3306

# ===== 后端 =====
JWT_SECRET=rental-apartment-demo-jwt-secret-2026-abcdefg
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JAVA_OPTS="-XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Shanghai"
